        <View android:layout_width="0dp" android:layout_height="250dp" android:layout_columnWeight="1" android:layout_margin="6dp" android:background="@drawable/bg_placeholder_card" />
        <View android:layout_width="0dp" android:layout_height="250dp" android:layout_columnWeight="1" android:layout_margin="6dp" android:background="@drawable/bg_placeholder_card" />
